# 复制为 deploy/.env.client 并按需修改；不要把真实令牌提交到版本库。
# 真实节点接入令牌由服务端配置或管理面板提供。
SERVER_URL=https://gw.example.com:443
AUTH_TOKEN=replace-with-node-token
CLIENT_ID=node-docker-1
ALIAS=Docker 测试节点 1
TAGS=docker,test
TRANSPORT=auto
PLANES=2
COMPRESSION=true
TLS_MODE=ca
LOG_LEVEL=info
# 节点自己的出口 IP 探测端点（逗号分隔）；不配置则使用内置默认值。
# 这两个变量只影响该节点，不是服务端的 geo.egress.*。
EGRESS_ECHO_URLS_V4=
EGRESS_ECHO_URLS_V6=
# GHCR 镜像 tag：latest / main / sha-<commit> / v1.0.x
TAG=latest
