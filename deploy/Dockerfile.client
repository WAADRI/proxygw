# syntax=docker/dockerfile:1
# proxygw 节点客户端镜像：多阶段构建，非 root，无入站端口（节点主动外连）。
FROM golang:1.24-alpine AS build
WORKDIR /src

# Buildx automatic platform args: GOARM must be set explicitly for linux/arm/v7.
ARG TARGETVARIANT

# 国内构建可覆盖：--build-arg GOPROXY=https://goproxy.cn,direct
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY} CGO_ENABLED=0 GOOS=linux

COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_TIME=unknown
RUN GOARM=${TARGETVARIANT#v} go build -trimpath -ldflags "-s -w \
    -X proxygw/internal/version.Version=${VERSION} \
    -X proxygw/internal/version.Commit=${COMMIT} \
    -X proxygw/internal/version.BuildTime=${BUILD_TIME}" \
    -o /out/proxygw-client ./cmd/proxygw-client

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S proxygw && adduser -S -G proxygw -h /var/lib/proxygw proxygw \
 && mkdir -p /etc/proxygw /var/lib/proxygw/state \
 && chown -R proxygw:proxygw /var/lib/proxygw
COPY --from=build /out/proxygw-client /usr/local/bin/proxygw-client
# 内置一份「环境变量优先」的默认配置；也可挂载自有配置覆盖该路径。
COPY deploy/config.client.docker.yaml /etc/proxygw/config.client.yaml
COPY config.client.example.yaml /etc/proxygw/config.client.example.yaml
USER proxygw
WORKDIR /var/lib/proxygw
VOLUME ["/var/lib/proxygw/state"]
ENTRYPOINT ["/usr/local/bin/proxygw-client"]
CMD ["-config", "/etc/proxygw/config.client.yaml"]
